{
  "name": "arcade",
  "type": "module",
  "version": "1.0.0",
  "description": "Arcade.js Library",
  "repository": "github:r3c/arcadejs",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check src",
    "build": "vite build",
    "format": "prettier --write src",
    "install": "node script/install.js",
    "start": "vite build && node script/start.js",
    "test": "vitest",
    "watch": "vite"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vitest": "^4.0.1"
  }
}
